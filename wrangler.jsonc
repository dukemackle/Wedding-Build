{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "wedding-build",
	"compatibility_date": "2026-09-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Plain (non-secret) runtime vars belong here, not just the dashboard --
	// each CI deploy runs `wrangler versions upload`, which resets the
	// Worker's vars to whatever's in this file. A dashboard-only var (like
	// ADMIN_EMAIL was) gets silently wiped on the very next deploy since
	// this file has no record of it. Secrets are unaffected by this and
	// still belong in the dashboard/`wrangler secret put`, never here.
	"vars": {
		"ADMIN_EMAIL": "dukemackle1@gmail.com"
	}
	// Optional upgrades once the app is live on Cloudflare:
	// - R2 incremental cache (persists ISR/data-cache across deploys): see
	//   https://opennext.js.org/cloudflare/caching -- requires creating an R2
	//   bucket first, then an `r2_buckets` entry here plus the matching
	//   override in open-next.config.ts.
	// - Cloudflare Images binding for next/image optimization: see
	//   https://opennext.js.org/cloudflare/howtos/image
}
