NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Drive picker ("Choose from Drive" on the importers and contract
# uploads). Both are public by design -- the client id and API key are visible
# in the browser, and access is granted per-file by the couple through
# Google's own picker with the drive.file scope. Leave blank and the buttons
# simply don't appear.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
