NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
# Marketing email (src/lib/marketing-email.ts). Without both, marketing sends
# are refused; transactional mail is unaffected. UNSUBSCRIBE_SECRET signs the
# unsubscribe links: any long random string (e.g. `openssl rand -hex 32`),
# never changed once emails have gone out or old links stop working.
# MARKETING_POSTAL_ADDRESS is the CAN-SPAM footer address, one line.
UNSUBSCRIBE_SECRET=
MARKETING_POSTAL_ADDRESS=
ANTHROPIC_API_KEY=
ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Drive picker ("Choose from Drive" on the importers and contract
# uploads). Both are public by design -- the client id and API key are visible
# in the browser, and access is granted per-file by the couple through
# Google's own picker with the drive.file scope. Leave blank and the buttons
# simply don't appear.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Unsplash Access Key for the guest site's free photo library
# (src/lib/unsplash.ts). Server-only; leave blank and "Find a free photo"
# doesn't appear. New apps are capped at 50 searches an hour until Unsplash
# approves production access.
UNSPLASH_ACCESS_KEY=
# Only for /weekly-review (scripts/weekly-review.mjs), never read by the app.
# Supabase personal access token (DB/storage size), Cloudflare token with
# Account Analytics: Read, and the account id.
SUPABASE_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Resend inbound/bounce webhook signing secret (starts with `whsec_`), from
# resend.com -> Webhooks -> the endpoint -> Signing secret.
RESEND_WEBHOOK_SECRET=
# Guest schedule texts (src/lib/sms.ts). Leave blank and SMS is off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Shared secret for /api/batch-sync and /api/import-batches: at least 32
# random characters (e.g. `openssl rand -hex 32`), the same value in the
# Worker and in the batch routine's environment.
BATCH_IMPORT_SECRET=
# Only for scripts/backup.mjs and scripts/restore.mjs, never read by the app.
# BACKUP_ENCRYPTION_KEY: 32 random bytes, base64 (see scripts/backup-crypto.mjs);
# losing it makes every backup unreadable, so keep a copy in the password manager.
BACKUP_ENCRYPTION_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SERVICE_ROLE_KEY=
